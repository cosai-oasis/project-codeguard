{
  "private": true,
  "scripts": {
    "format": "prettier --write --ignore-path=.prettierignore \"sources/**/*.{md,md.template,md.example}\"",
    "format:check": "prettier --check --ignore-path=.prettierignore \"sources/**/*.{md,md.template,md.example}\"",
    "lint": "markdownlint --dot \"sources/**/*.{md,md.template,md.example}\"",
    "format:release": "prettier --write --ignore-path=.prettierignore \"dist/**/*.{md,mdc}\" \"skills/codeguard/**/*.md\"",
    "lint:release": "markdownlint --dot \"dist/**/*.{md,mdc}\" \"skills/codeguard/**/*.md\"",
    "prepare:release": "npm run format:release && npm run lint:release"
  },
  "devDependencies": {
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.6"
  }
}
